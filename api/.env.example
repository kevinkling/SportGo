# Postgres de Supabase. Project Settings -> Database -> Connection string -> Session pooler (puerto 5432, NO el de transacción 6543: con consultas simultáneas se cuelga).
# Ojo: la contraseña va URL-encodeada y el host del pooler termina en .pooler.supabase.com
DATABASE_URL=postgresql://postgres.xxxxxxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Clave para firmar los tokens. Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=cambiame

# Supabase Storage (solo para el script de subida de fotos y video)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=espacios

# Opcional: Render define PORT solo
PORT=3000
