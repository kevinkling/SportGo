{
  "name": "sportgo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/servidor.ts",
    "build": "esbuild src/servidor.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/servidor.js",
    "start": "node dist/servidor.js",
    "migrar": "tsx --env-file=.env scripts/migrar.ts",
    "subir-medios": "tsx --env-file=.env scripts/subir-medios.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
