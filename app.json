{
  "expo": {
    "name": "SportGo",
    "slug": "sportgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono.png",
    "scheme": "sportgo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.villaguay.sportgo",
      "icon": "./assets/images/icono.png"
    },
    "android": {
      "package": "com.villaguay.sportgo",
      "adaptiveIcon": {
        "backgroundColor": "#f6f3ea",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f3ea",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#101410",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-video",
      "expo-asset",
      "expo-file-system",
      [
        "expo-camera",
        {
          "cameraPermission": "SportGo usa la cámara para que el encargado lea el código QR en la puerta.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SportGo usa Face ID para confirmar que sos vos al volver a abrir la app y antes de escanear un ingreso."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#172016"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SportGo usa tu ubicación para el mapa y para decir qué complejo queda más cerca. Si la denegás, el resto de la app sigue igual."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47e75bb4-bd76-43fd-ab16-58785d91786d"
      }
    }
  }
}
