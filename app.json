{
  "expo": {
    "name": "SportGo",
    "slug": "sportgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono.png",
    "scheme": "sportgo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.villaguay.sportgo",
      "icon": "./assets/images/icono.png"
    },
    "android": {
      "package": "com.villaguay.sportgo",
      "adaptiveIcon": {
        "backgroundColor": "#f6f3ea",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f3ea",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#101410",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-video",
      "expo-asset",
      "expo-file-system",
      [
        "expo-camera",
        {
          "cameraPermission": "SportGo usa la cámara para que el encargado lea el código QR en la puerta.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SportGo pide Face ID antes de escanear un ingreso."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#172016"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
